# Copy to a private file OUTSIDE the repository and use docker compose --env-file.
# A DNS hostname only: no scheme, path, or port. Point it at the selected server.
ARENA_DOMAIN=arena.example.com
# Keep registration closed while verifying the deployment, then set true.
ARENA_REGISTRATION_OPEN=false
# Optional private invitation code for a controlled early-access launch.
ARENA_INVITE_CODE=
