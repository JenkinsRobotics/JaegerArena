include VERSION README.md RELEASE_NOTES.md LICENSE AGENTS.md CONVENTIONS.md requirements.lock requirements-build.txt run.sh Dockerfile compose.yaml .env.example
include deploy/Caddyfile deploy/arena.env.example
recursive-include scripts *.py
